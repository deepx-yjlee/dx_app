{
  "version": 1,
  "name": "person-reid",
  "nodes": [
    { "id": "cam",  "type": "source", "uri": "sample/img/sample_people.jpg" },
    { "id": "od",   "model": "yolov8n",
      "params": { "score_threshold": 0.35 },
      "track":  { "algo": "iou", "iou": 0.3, "max_age": 30 } },
    { "id": "reid", "model": "casvit_t" }
  ],
  "edges": [
    { "from": "cam", "to": "od" },
    { "from": "od",  "to": "reid",
      "roi": { "classes": ["person"], "pad": 0.05, "max": 16 } }
  ]
}
